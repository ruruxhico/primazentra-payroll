#--------------------------------------------------------------------
# PrimaZentra Payroll — copy to .env and fill in.
# primazentra-hris/tools/hris_setup.php does this for all three apps
# and generates the matching API keys; see RUN-GUIDE.md.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost/hris-payroll/'
app.indexPage = ''
session.cookieName = 'hris_payroll_session'

# Firebase: the service-account key goes in writable/credentials/firebase_key.json (never committed)

HRIS_APP_NAME = payroll

# Main app: identity + employee master data
HRIS_MAIN_URL = http://localhost/primazentra-hris/
HRIS_MAIN_API_KEY = <same value as "payroll:" in primazentra-hris HRIS_API_KEYS>

# Attendance: approved DTR + period locks
HRIS_ATTENDANCE_URL = http://localhost/hris-attendance/
HRIS_ATTENDANCE_API_KEY = <same value as "payroll:" in hris-attendance HRIS_API_KEYS>

# Keys this app accepts on /api/v1/* (caller:key,caller:key)
HRIS_API_KEYS = main:<main's HRIS_PAYROLL_API_KEY>,attendance:<attendance's HRIS_PAYROLL_API_KEY>
